<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Raw capture on the Mac Mini every 15 minutes; each run takes only the snapshots due.
  __REPO__ and __HOME__ are substituted at install time; see README "Scheduling".
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.merritt.nba-props.capture</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/scripts/with-secrets.sh</string>
    <string>uv</string>
    <string>run</string>
    <string>python</string>
    <string>-m</string>
    <string>nbaprops.capture</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:__HOME__/.local/bin</string>
  </dict>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>StandardOutPath</key>
  <string>__REPO__/data/logs/capture.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/logs/capture.log</string>
</dict>
</plist>
